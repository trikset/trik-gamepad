<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <com.trikset.gamepad2.mjpeg.MjpegView
            android:id="@+id/video"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:contentDescription="@string/video_description"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextureView
            android:id="@+id/videoTexture"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/videoPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/video_placeholder"
        android:textColor="@color/video_placeholder_text"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Readability scrim: dark top/bottom edges so the translucent HUD stays legible over bright
         video frames. Placed above the video, below the controls; this view is not interactive. -->
    <View
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@drawable/hud_scrim"
        android:importantForAccessibility="no" />

    <!-- Layer 1 - pads (bottom layer): full-screen, equally divided. Each pad is a 260dp square
         centered in its half (SquareTouchPadLayout squares to min(width,height), so the explicit
         260dp keeps the pads smaller than the available space and clear of the status/buttons).
         Declared BEFORE the visuals so the chip/gear/buttons draw and receive touches above the
         pads - no runtime bringToFront (see MainActivity). -->
    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <com.trikset.gamepad2.SquareTouchPadLayout
                android:id="@+id/leftPad"
                android:layout_width="@dimen/hud_pad_size"
                android:layout_height="@dimen/hud_pad_size"
                android:layout_gravity="center"
                android:background="@drawable/hud_pad_glass"
                android:contentDescription="@string/left_pad_description">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hud_pad_chrome"
                    android:tag="padChrome" />
            </com.trikset.gamepad2.SquareTouchPadLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <com.trikset.gamepad2.SquareTouchPadLayout
                android:id="@+id/rightPad"
                android:layout_width="@dimen/hud_pad_size"
                android:layout_height="@dimen/hud_pad_size"
                android:layout_gravity="center"
                android:background="@drawable/hud_pad_glass"
                android:contentDescription="@string/right_pad_description">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hud_pad_chrome"
                    android:tag="padChrome" />
            </com.trikset.gamepad2.SquareTouchPadLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- HUD controls container (edge-to-edge interactive layer): wraps the edge-pinned controls
         (robot chip, gear, magic buttons), which sit flush to the screen corners/edges with a
         small margin. Chrome deliberately ignores the window insets (status bar, display cutout,
         gesture-nav zones): on typical hardware the camera is not in the landscape short edge and
         the bottom nav gestures overlap is an accepted trade-off, so the controls may reach the
         true screen edges. Only the video and pads need cutout clearance, and those live outside
         this container (the full-bleed window still draws behind the cutout). The container is a
         sibling above the pads layer (z-order preserved) and below the center pills; the video
         stays full-bleed under everything. -->
    <RelativeLayout
        android:id="@+id/hudControls"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <!-- Robot-target chip (top-left): shows the configured host (or the video stream's host in
             video-only mode, or a filler when neither is set) flanked by two connection-status glyphs:
             the move-cross (start) reports the CONTROL connection, the eye (end) reports the VIDEO
             connection. Each glyph is tinted to its own state color at runtime (green/amber/sepia/red
             for control, green/amber/red/gray for video — see VideoStatus). The host text is neutral
             white; the glyphs carry the color ("color is never the only signal", DESIGN.md). The chip
             is one tappable action that opens the robot/target settings; its dynamic contentDescription
             announces both connection states. The host text is deliberately NOT selectable
             (tools:ignore): it is an action, so long-press selection would fight the tap. -->
        <LinearLayout
            android:id="@+id/targetChip"
            style="@style/Hud.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/hud_half_glyph"
            android:layout_marginStart="@dimen/hud_pill_padding_h"
            android:clickable="true"
            android:contentDescription="@string/target_chip_description"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Control status badge: the move-cross glyph, tinted to the control connection accent
                 (set at runtime by MainActivity.applyHudTone). -->
            <FrameLayout
                android:layout_width="@dimen/hud_status_badge_size"
                android:layout_height="@dimen/hud_status_badge_size">

                <ImageView
                    android:layout_width="@dimen/hud_status_glyph_size"
                    android:layout_height="@dimen/hud_status_glyph_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hud_pad_glyph_move"
                    android:tag="controlStatusIcon" />
            </FrameLayout>

            <TextView
                android:id="@+id/targetChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hud_chip_badge_gap"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="SelectableText" />

            <!-- Video status badge: the eye glyph, tinted to the video connection state color (set at
                 runtime by MainActivity.applyVideoStatusIcon). -->
            <FrameLayout
                android:layout_width="@dimen/hud_status_badge_size"
                android:layout_height="@dimen/hud_status_badge_size"
                android:layout_marginStart="@dimen/hud_chip_badge_gap">

                <ImageView
                    android:layout_width="@dimen/hud_status_glyph_size"
                    android:layout_height="@dimen/hud_status_glyph_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hud_pad_glyph_look"
                    android:tag="videoStatusIcon" />
            </FrameLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/hud_half_glyph"
            android:layout_marginBottom="@dimen/hud_half_glyph"
            android:background="@drawable/btn_settings"
            android:contentDescription="@string/settings_button_description"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:padding="0dp"
            android:text="@string/settings_gear_glyph"
            android:textColor="@color/hud_accent_connected"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/btnSettings"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            >

        </LinearLayout>
    </RelativeLayout>

    <!-- Kept as the LAST children of main (defensive convention): child order is the z-order, so
         the pads layer (controlsOverlay) is declared before the visuals and the visuals before
         anything that must stay on top. No runtime bringToFront. The spinner is centered via
         layout params and stays under the connection pill. -->
    <ProgressBar
        android:id="@+id/videoLoading"
        style="?android:attr/progressBarStyle"
        android:layout_width="@dimen/video_loading_size"
        android:layout_height="@dimen/video_loading_size"
        android:layout_centerInParent="true"
        android:importantForAccessibility="no"
        android:indeterminateTint="@color/hud_accent_connected"
        android:padding="14dp"
        android:visibility="gone" />

    <!-- "Video reconnecting…" badge: shown only when a stream that WAS playing reloads (a
         reconnect), so the user can tell a reload apart from the first load (the spinner alone
         covers both). Hidden on the first frame / pause (MainActivity.setVideoLoading(false)). -->
    <TextView
        android:id="@+id/videoReconnecting"
        style="@style/Hud.GlassPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginTop="80dp"
        android:text="@string/video_reconnecting"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Connection status pill (⏻ tap-to-connect / ↺ connecting), hidden once connected
         (ConnectionFeedback.setStatusText). Centered; minHeight 48dp = the tap-to-connect touch
         target; the state glyph is bundled-font text set at runtime by ConnectionFeedback. -->
    <TextView
        android:id="@+id/connectionStatus"
        style="@style/Hud.GlassPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Connection-error pill (transient): a content-sized glass bar shown by
         ConnectionFeedback.error() for real connection errors (not the persistent status pill).
         wrap_content width = always fits the message; positioned at runtime between the status
         pill and the magic-button row; fade-in/auto-dismiss handled by ConnectionFeedback. -->
    <TextView
        android:id="@+id/connectionError"
        style="@style/Hud.GlassPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:maxLines="2"
        android:textColor="@color/white"
        android:textSize="@dimen/hud_snackbar_text_size"
        android:visibility="gone" />


</RelativeLayout>
